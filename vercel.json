{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node --experimental-strip-types scripts/build.mjs",
  "outputDirectory": "public",
  "regions": ["lhr1"],
  "redirects": [
    {
      "source": "/:path((?!api(?:/|$))(?:[^/]+/)*[^/.]+)",
      "destination": "/:path/",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cleanup-enquiries",
      "schedule": "30 3 * * *"
    }
  ],
  "functions": {
    "api/chat.js": {
      "maxDuration": 30
    },
    "api/cleanup-enquiries.js": {
      "maxDuration": 60
    }
  }
}
